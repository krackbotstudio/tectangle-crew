{
  "name": "agentdesk",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "agentdesk-web",
    "agentdesk-api"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev": "concurrently -n api,web -c blue,green \"npm run dev --prefix agentdesk-api\" \"npm run dev --prefix agentdesk-web\"",
    "seed": "npm run seed --prefix agentdesk-api",
    "build": "npm run build --prefix agentdesk-web",
    "vercel-build": "npm run build --prefix agentdesk-web",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down"
  },
  "devDependencies": {
    "@vercel/node": "^5.1.10",
    "concurrently": "^9.1.2"
  }
}
