# Agent Desk — local development

# Frontend URL (OAuth redirect target)
FRONTEND_URL=http://localhost:5173

# Google OAuth — create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3001/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# Set to false to disable public sign-up (Google + email)
ALLOW_SIGNUP=true

DATABASE_URL=postgresql://agentdesk:agentdesk@localhost:5432/agentdesk
API_PORT=3001
JWT_SECRET=agentdesk-dev-jwt-secret-change-in-production
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=
WEBHOOK_SECRET=agentdesk-dev-secret
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
UPLOAD_DIR=./agentdesk-api/uploads

# Leave unset to auto-fallback to embedded PGlite when Postgres is unreachable
# USE_EMBEDDED_DB=true
# EMBEDDED_DB_DIR=./data/pglite
# OPENAI_API_KEY=

# n8n Docker env (set in docker-compose or n8n UI)
# N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
# AGENTDESK_API_URL=http://host.docker.internal:3001
